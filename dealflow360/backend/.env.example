# DealFlow360 Environment Variables
# Compatible with XAMPP MySQL and standard MySQL Server (port 3306)

DB_HOST=localhost
DB_PORT=3306
DB_NAME=dealflow360
DB_USER=root
DB_PASSWORD=

JWT_SECRET_KEY=dealflow360-secure-jwt-secret-key-development-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

FRONTEND_ORIGIN=http://localhost:5173
PORT=8001
